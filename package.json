{
  "name": "drum-practice-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:i18n && npm run ui:docs && node scripts/build/third-party.mjs && node scripts/build/build-info.mjs && tsc --noEmit && npm run check:playback && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "predev": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "review:local": "python3 tools/apple-local/workflow.py",
    "test:local": "python3 -m unittest discover -s tools/apple-local -p \"test_*.py\"",
    "pretest": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "ui:docs": "node scripts/build/ui-docs.mjs",
    "check:i18n": "node scripts/checks/check-i18n.mjs",
    "check:playback": "node scripts/checks/check-playback-architecture.mjs && node scripts/checks/check-common-components.mjs && npm run check:structure",
    "dev:editor": "vite --host 127.0.0.1 --open /editor.html",
    "dev:player": "vite --host 127.0.0.1 --open /player.html",
    "build:apps": "npm run check:i18n && node scripts/build/third-party.mjs && node scripts/build/build-info.mjs && tsc --noEmit && npm run check:playback && vite build --mode editor && vite build --mode player && node scripts/checks/check-app-boundaries.mjs",
    "test:drum": "node scripts/checks/check-local-assets.mjs && vitest run",
    "version:app": "node scripts/release/bump-app-version.mjs",
    "check:structure": "node scripts/checks/check-source-boundaries.mjs",
    "pretest:drum": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "test:portable": "vitest run tests/unit tests/integration",
    "pretest:portable": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "test:local-media": "node scripts/checks/check-local-assets.mjs && vitest run tests/local-media",
    "pretest:local-media": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "music-metadata": "^12.2.0",
    "music-tempo": "1.0.3",
    "opensheetmusicdisplay": "^2.1.2",
    "pdfjs-dist": "^6.3.289",
    "soundtouchjs": "^0.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
