{
  "name": "drum-practice-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:apps",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --mode player --open /player.html",
    "predev": "npm run generate",
    "review:local": "python3 tools/apple-local/workflow.py",
    "test:local": "python3 -m unittest discover -s tools/apple-local -p \"test_*.py\"",
    "pretest": "npm run generate",
    "ui:docs": "node scripts/build/ui-docs.mjs",
    "check:i18n": "node scripts/checks/check-i18n.mjs",
    "check:playback": "node scripts/checks/check-playback-architecture.mjs && node scripts/checks/check-common-components.mjs && npm run check:structure",
    "dev:editor": "vite --host 127.0.0.1 --open /editor.html",
    "dev:player": "vite --host 127.0.0.1 --open /player.html",
    "build:apps": "npm run generate && npm run check:i18n && npm run check:docs && npm run typecheck:app && npm run check:playback && vite build --mode editor && vite build --mode player && node scripts/checks/check-app-boundaries.mjs",
    "test:drum": "node scripts/checks/check-local-assets.mjs && vitest run",
    "version:app": "node scripts/release/bump-app-version.mjs",
    "check:structure": "node scripts/checks/check-source-boundaries.mjs",
    "pretest:drum": "npm run generate",
    "test:portable": "vitest run tests/unit tests/integration",
    "pretest:portable": "npm run generate",
    "test:local-media": "node scripts/checks/check-local-assets.mjs && vitest run tests/local-media",
    "pretest:local-media": "npm run generate",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "generate": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "predev:editor": "npm run generate",
    "predev:player": "npm run generate",
    "pretypecheck:app": "npm run generate",
    "pretypecheck:tools": "npm run generate",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "typecheck:hosting": "tsc --project hosting/tsconfig.json",
    "typecheck": "npm run typecheck:app && npm run typecheck:tools && npm run typecheck:hosting",
    "format:check": "node scripts/checks/check-format.mjs",
    "check:docs": "node scripts/build/ui-docs.mjs --check && node scripts/checks/check-docs.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run check:i18n && npm run check:playback && npm run check:docs",
    "verify:portable": "npm run check && npm run test:portable",
    "verify": "npm run check && npm run test:drum && npm run build"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "music-metadata": "^12.2.0",
    "music-tempo": "1.0.3",
    "opensheetmusicdisplay": "^2.1.2",
    "pdfjs-dist": "^6.3.289",
    "soundtouchjs": "^0.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.7",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  }
}
