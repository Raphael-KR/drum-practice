{
  "name": "drum-practice-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "catalog:sync": "node scripts/dependencies/sync-catalog.mjs && pnpm install",
    "catalog:check": "node scripts/dependencies/sync-catalog.mjs --check",
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm run build:apps",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --mode player --open /player.html",
    "predev": "pnpm run generate",
    "review:local": "python3 tools/apple-local/workflow.py",
    "test:local": "python3 -m unittest discover -s tools/apple-local -p \"test_*.py\"",
    "pretest": "pnpm run generate",
    "ui:docs": "node scripts/build/ui-docs.mjs",
    "check:i18n": "node scripts/checks/check-i18n.mjs",
    "check:playback": "node scripts/checks/check-playback-architecture.mjs && node scripts/checks/check-common-components.mjs && pnpm run check:structure",
    "dev:editor": "vite --host 127.0.0.1 --open /editor.html",
    "dev:player": "vite --host 127.0.0.1 --open /player.html",
    "build:apps": "pnpm run generate && pnpm run check:i18n && pnpm run check:docs && pnpm run typecheck:app && pnpm run check:playback && vite build --mode editor && vite build --mode player && node scripts/checks/check-app-boundaries.mjs",
    "test:drum": "node scripts/checks/check-local-assets.mjs && vitest run",
    "version:app": "node scripts/release/bump-app-version.mjs",
    "check:structure": "node scripts/checks/check-source-boundaries.mjs",
    "check:dependencies": "node scripts/checks/check-jszip.mjs",
    "pretest:drum": "pnpm run generate",
    "test:portable": "vitest run tests/unit tests/integration",
    "pretest:portable": "pnpm run generate",
    "test:local-media": "node scripts/checks/check-local-assets.mjs && vitest run tests/local-media",
    "pretest:local-media": "pnpm run generate",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "generate": "node scripts/build/third-party.mjs && node scripts/build/build-info.mjs",
    "predev:editor": "pnpm run generate",
    "predev:player": "pnpm run generate",
    "pretypecheck:app": "pnpm run generate",
    "pretypecheck:tools": "pnpm run generate",
    "typecheck:app": "tsc --noEmit",
    "typecheck:tools": "tsc --project tsconfig.tools.json",
    "typecheck:hosting": "tsc --project hosting/tsconfig.json",
    "typecheck": "pnpm run typecheck:app && pnpm run typecheck:tools && pnpm run typecheck:hosting",
    "format:check": "node scripts/checks/check-format.mjs",
    "check:docs": "node scripts/build/ui-docs.mjs --check && node scripts/checks/check-docs.mjs",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run check:dependencies && pnpm run check:i18n && pnpm run check:playback && pnpm run check:docs",
    "verify:portable": "pnpm run check && pnpm run test:portable",
    "verify": "pnpm run check && pnpm run test:drum && pnpm run build"
  },
  "dependencies": {
    "jszip": "catalog:",
    "music-metadata": "catalog:",
    "music-tempo": "catalog:",
    "opensheetmusicdisplay": "catalog:",
    "pdfjs-dist": "catalog:",
    "soundtouchjs": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@napi-rs/canvas": "catalog:",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "fake-indexeddb": "catalog:",
    "globals": "catalog:",
    "jsdom": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
