{
  "name": "drum-practice-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check:i18n && npm run ui:docs && npm run portable && tsc --noEmit && npm run check:playback && vite build",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "portable": "node scripts/build-portable.mjs",
    "predev": "npm run portable",
    "review:local": "python3 scripts/apple-local/workflow.py",
    "test:local": "python3 -m unittest discover -s scripts/apple-local -p \"test_*.py\"",
    "pretest": "node scripts/third-party.mjs && node scripts/build-info.mjs",
    "ui:docs": "node scripts/ui-docs.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:playback": "node scripts/check-playback-architecture.mjs && node scripts/check-common-components.mjs && node scripts/check-playback-build.mjs",
    "dev:editor": "vite --host 127.0.0.1 --open /editor.html",
    "dev:player": "vite --host 127.0.0.1 --port 5174 --open /player.html",
    "build:apps": "npm run check:i18n && npm run portable && tsc --noEmit && vite build --mode editor && vite build --mode player && node scripts/check-app-boundaries.mjs",
    "test:drum": "vitest run --exclude 'guitar-practice/**'"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "opensheetmusicdisplay": "^2.1.2",
    "pdfjs-dist": "^6.3.289",
    "soundtouchjs": "^0.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.3",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.7",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.1"
  }
}
