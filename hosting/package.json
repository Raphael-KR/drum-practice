    "vite": "8.3.5",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "miniflare": {
      "undici": "7.30.1"
    }
  }
