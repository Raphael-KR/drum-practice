{
  "name": "drum-practice-site-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node --import ./scripts/sites-env.mjs ./node_modules/vite/bin/vite.js build && node scripts/finalize.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
